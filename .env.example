# Copy this file to `.env` (same folder you run iglite from, or ~/.iglite/.env)
# and fill in the keys you have. `.env` is git-ignored, so keys never get committed.
# Leave a value empty to keep that source switched off.

SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
ABUSECH_AUTH_KEY=

# AI analyst (optional; needs `pip install .[ai]`): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: require a token for the dashboard/API (needed to listen beyond localhost)
# IGLITE_API_TOKEN=
